{
  "expo": {
    "name": "Plane",
    "slug": "plane-mobile",
    "scheme": "plane",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router"],
    "ios": {
